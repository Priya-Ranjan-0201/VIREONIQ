# ═══════════════════════════════════════════════════════════════
#  PLACEIQ (VIREONIQ) — Root Environment Configuration
#  Used by docker-compose.yml for full-stack Docker deployment.
#  Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════

# ─── General ──────────────────────────────────────────────────
ENVIRONMENT=development
PROJECT_NAME=PLACEIQ
SECRET_KEY=your-super-secret-key-change-in-production

# ─── Database Connections (Docker internal hostnames) ─────────
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/placeiq
MONGO_URL=mongodb://admin:password@mongodb:27017/placeiq?authSource=admin
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# ─── Database Credentials (used by docker-compose services) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=placeiq
MONGO_USER=admin
MONGO_PASSWORD=password

# ─── JWT / Authentication ────────────────────────────────────
# RS256 key paths (inside Docker container)
JWT_PRIVATE_KEY_PATH=/app/keys/private_key.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public_key.pem

# ─── LLM Providers ──────────────────────────────────────────
# Supported: nvidia_nim | gemini | claude | openai
NVIDIA_NIM_API_KEY=nvapi-REPLACE_ME
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
GEMINI_API_KEY=AIzaSy-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
OPENAI_API_KEY=sk-REPLACE_ME

# ─── Code Execution (Judge0) ────────────────────────────────
JUDGE0_API_URL=http://judge0-server:2358
JUDGE0_API_KEY=REPLACE_ME

# ─── OAuth (Google Sign-In) ──────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME

# ─── GitHub Integration ──────────────────────────────────────
GITHUB_TOKEN=ghp_REPLACE_ME

# ─── Storage (AWS S3 or S3-Compatible) ───────────────────────
S3_BUCKET=placeiq-resumes
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_REGION=us-east-1
S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com

# ─── Communications ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACreplace_me
TWILIO_AUTH_TOKEN=replace_me
SENDGRID_API_KEY=SG.replace_me

# ─── Observability ──────────────────────────────────────────
SENTRY_DSN=https://replace_me@o0.ingest.sentry.io/0

# ─── Application URLs ───────────────────────────────────────
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost:8000
