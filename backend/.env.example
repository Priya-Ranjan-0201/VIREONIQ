# =============================================
# VIREONIQ API — Environment Configuration
# Copy this file to .env and fill in values
# =============================================

PROJECT_NAME="VIREONIQ API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"  # development | staging | production

# ─── CORS ────────────────────────────────────
# JSON Array. Add your Vercel frontend domain in production.
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ─── JWT / AUTH ──────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM="RS256"
PRIVATE_KEY_PATH=".secrets/private_key.pem"
PUBLIC_KEY_PATH=".secrets/public_key.pem"

# ─── POSTGRESQL ───────────────────────────────
POSTGRES_USER="vireoniq_user"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
POSTGRES_SERVER="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="vireoniq_db"

# ─── REDIS ────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ─── AWS S3 (Resume Storage) ──────────────────
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="vireoniq-resumes-prod"
S3_SIGNED_URL_EXPIRY=3600

# ─── LLM PROVIDERS ───────────────────────────
DEFAULT_LLM_PROVIDER="nvidia_nim"  # claude | openai | gemini | nvidia_nim
ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"
OPENAI_API_KEY="sk-REPLACE_ME"
GEMINI_API_KEY="AIzaSy-REPLACE_ME"
NVIDIA_NIM_API_KEY="nvapi-REPLACE_ME"
INTERVIEW_MAX_TURNS=10
CLAUDE_MODEL="claude-3-5-sonnet-20241022"

# ─── RAZORPAY (India-first Payments) ─────────
RAZORPAY_KEY_ID="rzp_live_REPLACE_ME"
RAZORPAY_KEY_SECRET="REPLACE_ME"
RAZORPAY_WEBHOOK_SECRET="REPLACE_ME"

# ─── OBSERVABILITY ────────────────────────────
SENTRY_DSN="https://REPLACE@sentry.io/REPLACE"
ENABLE_ANALYTICS=true

# ─── EMAIL (for OTP / transactional) ─────────
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="SG.REPLACE_ME"
EMAILS_FROM="noreply@vireoniq.com"
